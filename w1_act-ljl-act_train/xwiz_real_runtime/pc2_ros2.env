# ROS2 environment for xwiz (preserved on upgrade). Edit as needed.
# Set XWIZ_ROS2_ENABLE=1 to activate ROS2 bridge module.
export XWIZ_ROS2_ENABLE=1
# Non-standard ROS 2 installation prefix (override if using custom build)
export ROS2_PREFIX=/opt/ros/humble
# Optionally source distro setup from ROS2_PREFIX (wrapper script will source if present)
# export DISTRO_SETUP="$ROS2_PREFIX/setup.bash"
# RMW implementation (rmw_fastrtps_cpp, rmw_cyclonedds_cpp, rmw_connextdds, etc.)
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# ROS domain for isolating networks
export ROS_DOMAIN_ID=20
export CYCLONEDDS_URI="<CycloneDDS><Domain><General><Interfaces><NetworkInterface address=\"192.168.20.21\"/></Interfaces><AllowMulticast>spdp</AllowMulticast></General></Domain></CycloneDDS>"
# CycloneDDS XML path (only if using cyclonedds)
# export CYCLONEDDS_URI=/etc/xwiz/cyclonedds.xml
# Network interface hint (custom logic may use this)
# export XWIZ_NET_IFACE=eth0
